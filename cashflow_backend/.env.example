# Copy to .env (never commit .env). Placeholder values only.
SECRET_KEY=change-me
DEBUG=True
DATABASE_NAME=cashflow_db
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
DATABASE_HOST=localhost
DATABASE_PORT=5432

